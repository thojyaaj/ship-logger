# Signs the session cookie. Set a real random value in production —
# without it, sessions fall back to an insecure dev-only secret and every
# restart's tokens stay valid forever (see lib/auth.ts).
SESSION_SECRET=

# Postgres connection string (lib/db/index.ts). Against Supabase, use the
# transaction pooler URL (port 6543) — direct connections exhaust quickly
# across serverless invocations.
DATABASE_URL=

# Optional: protects /api/cron/epg-status from being triggered by anyone
# who finds the URL. Vercel Cron sends this automatically when set — see
# vercel.json and https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=

# Seeds the first admin user's PIN when the database is empty (npm run db:seed).
SEED_ADMIN_PIN=1234

# Shopify Admin API custom-app credential (lib/shopify.ts) — client-credentials
# grant, used for every read query in this app (order lookups, the order
# index backfill). Needs read_orders, read_all_orders, read_fulfillments,
# and read_customers scopes approved on the store, plus protected customer
# data access (see README).
SHOPIFY_STORE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# UPS Track API (developer.ups.com) — OAuth 2.0 client credentials, used by
# /api/cron/ups-status to refresh each shipment's master UPS tracking status.
# Get these from a UPS developer account; without them the cron no-ops.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# Optional: https://wwwcie.ups.com for UPS's CIE/sandbox environment.
# Defaults to the production API (https://onlinetools.ups.com).
UPS_API_BASE=

# DHL Express MyDHL API (developer.dhl.com) — HTTP Basic Auth, used by the
# admin-confirmed "Schedule DHL Pickup" action on a submitted shipment's
# detail page. Getting these requires DHL-side onboarding tied to an active
# DHL Express account, not pure self-service signup. Without them, scheduling
# a pickup fails with a clear "not configured yet" message rather than
# crashing — the account number and pickup-window settings are configured
# separately in the app at /admin/dhl-pickup, not here.
DHL_CLIENT_ID=
DHL_CLIENT_SECRET=
# Optional: https://express.api.dhl.com/mydhlapi/test for DHL's test
# environment. Defaults to the production API
# (https://express.api.dhl.com/mydhlapi).
DHL_API_BASE=

# DHL Shipment Tracking – Unified (developer.dhl.com) — a separate DHL API
# from the pickup credentials above: single API-key header auth, used by
# /api/cron/dhl-status to refresh each scanned DHL parcel's status. Free tier
# is 250 calls/day at 1 call per 5 seconds; without this key the cron no-ops.
DHL_TRACKING_API_KEY=
# Optional override of the tracking API's base URL. Defaults to the
# production API (https://api-eu.dhl.com/track/shipments).
DHL_TRACKING_API_BASE=

# Resend (resend.com) — sends the daily admin alert digest for exception
# (customs/duties/delivery-problem) and stale (no status update in 7+ days)
# shipments, see /api/cron/shipment-alerts and /admin/exceptions. Without
# this key the cron still runs and the in-app banner/exceptions page still
# work — only the email step no-ops.
RESEND_API_KEY=
# Optional overrides — default to alerts@otcshoppeexpress.com and
# otcshoppeexpress@gmail.com (lib/email.ts). ALERT_TO_EMAILS accepts a
# comma-separated list for more than one recipient. The from-address domain
# must be verified in Resend before it can send.
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=
